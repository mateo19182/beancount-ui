{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "beancount-ui",
  "version": "0.2.0",
  "identifier": "com.beancount.ui",
  "build": {
    "beforeDevCommand": "sh -c 'if [ -f frontend/package.json ]; then cd frontend; else cd ../frontend; fi && npm run dev'",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "sh -c 'if [ -f frontend/package.json ]; then cd frontend; else cd ../frontend; fi && VITE_API_URL=http://127.0.0.1:8742 npm run build'",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Beancount",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "../backend": "backend"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
